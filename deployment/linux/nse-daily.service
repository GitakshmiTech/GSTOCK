[Unit]
Description=NSE Market Data Pipeline Daily EOD Ingestion
After=network.target mysql.service

[Service]
Type=oneshot
User=nse
Group=nse
WorkingDirectory=/opt/nse_market_data_pipeline
EnvironmentFile=/opt/nse_market_data_pipeline/.env
ExecStart=/opt/nse_market_data_pipeline/.venv/bin/python -m nse_pipeline.cli.daily_update
StandardOutput=journal
StandardError=journal
Restart=no

[Install]
WantedBy=multi-user.target
