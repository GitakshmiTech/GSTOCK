<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gitakshmi.nse-daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/apple/nse_market_data_pipeline && .venv/bin/python -m nse_pipeline.cli.daily_update</string>
    </array>

    <!-- Run daily at 16:00 (4:00 PM) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>16</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/apple/nse_market_data_pipeline/logs/daily_update.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/apple/nse_market_data_pipeline/logs/daily_update.stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
